+/* DRAFT (unverified): UMA-OOM guard for the glm53 VK expert tier.
+ * On unified-memory devices (gfx1151) VK arena allocations come straight
+ * out of system RAM and the arena never returns blocks to the OS, so an
+ * uncapped expert tier grows monotonically (~4.8 GB unique expert bytes
+ * per token) -> global OOM after ~90 s decode (docs/benchmarks.md).
+ * Gate NEW uploads at GLM53_VK_BUDGET_GB (default 24 GB device-side);
+ * experts over the cap stay on the CPU path. Mirrors the
+ * COLI_VK_RESERVE_GB pattern of vk_registry_fill in colibri.c. */
+static double g_vk_budget_gb = -1.0;
+static int vk_expert_budget_ok(void) {
+    if (g_vk_budget_gb < 0) {
+        const char *e = getenv("GLM53_VK_BUDGET_GB");
+        g_vk_budget_gb = e ? atof(e) : 24.0;
+    }
+    if (g_vk_budget_gb <= 0) return 1;                /* gate disabled */
+    double used = 0, total = 0;
+    if (!coli_vk_mem_budget(&used, &total)) return 1; /* no VK_EXT_memory_budget: no gate */
+    return used < g_vk_budget_gb;
+}
